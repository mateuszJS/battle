{
  "compilerOptions": {
    "target": "es6",
    "sourceMap": true,
    "module": "ESNext", // Pixi works with commonJS, but dynamic imports works with ESNext </3
    "moduleResolution": "node", // to fix above comment, no pixi is resolved correctly
    // ^ also with that we don't have to import PIXI in each file
    "importHelpers": true,
    "allowJs": true, // numeric librayr uses js, also WebAssembly might need it
    "baseUrl": "./visual",
    "typeRoots": ["./node_modules/@webgpu/types", "./node_modules/@types", "./global.d.ts"], // added because of WebGPU types. Also had to add node_modules/@types, because typeRoots override default typeRoots, not extends
    "paths": {
      "Universe": ["../crate/pkg"],
      "assets": ["../assets"]
    },

    // everything below is just suggested by https://www.npmjs.com/package/@tsconfig/recommended
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "exclude": [
    "eslint.config.mjs",
    "./crate/**/*",
    "./pkg/**/*",
    "build-sprite-sheets.js",
    "webpack.config.js",
  ],
  "$schema": "https://json.schemastore.org/tsconfig", // @tsconfig/recommended
  "display": "Recommended", // @tsconfig/recommended
}
