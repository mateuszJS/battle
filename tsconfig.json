{
  "compilerOptions": {
    "target": "es6",
    "sourceMap": true,
    "module": "ESNext", // Pixi works with commonJS, but dynamic imports works with ESNext </3
    "moduleResolution": "node", // to fix above comment, no pixi is resolved correctly
    // ^ also with that we don't have to import PIXI in each file
    "importHelpers": true,
    "allowJs": true, // to import web assembly module
    "baseUrl": "./visual",
    "typeRoots": ["./node_modules/@webgpu/types", "./node_modules/@types"], // added because of WebGPU types. Also had to add node_modules/@types, because typeRoots override default typeRoots, not extends
    "paths": {
      "Universe": ["../crate/pkg"]
    },

    // everything below is just suggested by https://www.npmjs.com/package/@tsconfig/recommended
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "$schema": "https://json.schemastore.org/tsconfig", // @tsconfig/recommended
  "display": "Recommended", // @tsconfig/recommended
}
