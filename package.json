  "main": "webpack.config.js",
  "scripts": {
    "dev": "export NODE_ENV=development && webpack serve --open",
    "build": "webpack --display-optimization-bailout --config webpack.prod.js",
    "build-as": "asc -b logic/index.wasm -t logic/index.wat logic/index.ts",
