    "file-loader": "^0.11.2",
    "html-webpack-plugin": "^5.6.3",
    "prettier": "^1.19.1",
    "raw-loader": "^4.0.1",
    "ts-loader": "^8.2.0",
    "tslib": "^2.2.0",
    "typescript": "^4.2.4",
    "webpack": "^5.105.0",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^5.1.4",
    "webpack-dashboard": "^3.3.8",
    "webpack-dev-server": "^5.1.0",
    "webpack-merge": "^4.1.0"
  },
